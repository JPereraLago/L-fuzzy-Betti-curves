    }
   ],
   "source": [
    "plt.figure(figsize=(5, 3))\n",
    "plt.scatter(data[:, 0], data[:, 1],color='k',zorder=3)\n",
    "for i in range(len(data)):\n",
    "    plt.text(data[i, 0]-0.1, data[i, 1], str(fuzzy_values_01[i]), fontsize=10, ha='right',zorder=4)\n",
    "plt.xlabel('')\n",
    "plt.title('L-fuzzy dataset (L=[0,1])')\n",
    "plt.axis('equal')\n",
    "plt.grid(True,alpha=0.3,zorder=0)\n",
    "plt.xlim(-0.75,4.5)\n",
    "plt.savefig('plots/01_dataset.pdf')\n",
    "plt.show()"
   ]
  },
