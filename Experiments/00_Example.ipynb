   "metadata": {},
   "outputs": [],
   "source": [
    "data = np.array([\n",
    "    [ 0,  0],\n",
    "    [ 0, -2],\n",
    "    [ 2,  0],\n",
    "    [ 2, -2],\n",
    "    [ 3,  0],\n",
    "    [ 3, -2],\n",
    "    [ 4, -1]\n",
    "])\n",
    "fuzzy_values_01 = [1.,1.,0.8,0.8,0.5,0.5,0.6]\n",
    "fuzzy_values_xy = ['x','x','x','x','y','y','y']"
   ]
  },
  {
