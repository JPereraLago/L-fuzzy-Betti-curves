    "plt.scatter(data[mask_x, 0], data[mask_x, 1], c='b', marker='x', label='x', zorder=3)\n",
    "plt.scatter(data[mask_y, 0], data[mask_y, 1], c='r', marker='o', label='y', zorder=3)\n",
