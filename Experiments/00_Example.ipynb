       "       [0.        , 0.70710678],\n",
       "       [0.        , 1.        ],\n",
       "       [0.        , 1.        ],\n",
       "       [0.        ,        inf]])"
      ]
     },
     "execution_count": 7,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "H0 = simplex_tree.persistence_intervals_in_dimension(0)\n",
    "H0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
