   "id": "4ae54eb6-105a-49d5-99df-fa5da391d18f",
   "metadata": {},
   "source": [
    "# Crisp curves"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "5a82855b-7ea1-4ac8-878a-4294340ec9e7",
   "metadata": {},
   "outputs": [],
   "source": [
    "homology_coeff_field = 2\n",
    "predefined_grid = np.arange(0,2.5,0.1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "35023bbf-dec3-4a27-8621-74ff8db8d32b",
   "metadata": {},
   "outputs": [],
   "source": [
    "alpha = AlphaComplex(points=data)\n",
    "simplex_tree = alpha.create_simplex_tree(output_squared_values=False)\n",
    "simplex_tree.compute_persistence(homology_coeff_field=homology_coeff_field, persistence_dim_max=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bba1b8d7-af78-4734-8a14-a21639329bea",
   "metadata": {},
   "source": [
